# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Domínio do site (ex.: vagai.com.br). Usado pelo Caddy para o HTTPS.
DOMINIO=

# Endereço público completo, usado no aviso de pagamento do Mercado Pago.
URL_PUBLICA=https://

# Chave de instalação: só cria a PRIMEIRA conta da equipe em /#/equipe (as outras entram por convite).
# Gere uma longa e aleatória:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANALISTA_TOKEN=

# Chave que criptografa denúncias e fotos. Gere do mesmo jeito, guarde uma cópia segura e NUNCA troque:
# sem ela os dados ficam ilegíveis.
CHAVE_CRIPTOGRAFIA=

# Nome que aparece no aplicativo autenticador da equipe (opcional)
# PAINEL_NOME=Vagai Equipe

# Onde estão o banco e as fotos (já configurado no Docker).
# DATABASE_URL=sqlite:////data/app.db
# UPLOAD_DIR=/data/uploads

# Como ler o IP real do visitante (para o limite de tentativas):
#   cloudflare -> site atrás do Cloudflare (proxy laranja ligado)
#   1          -> atrás do Caddy ou da Railway, sem Cloudflare
CONFIAR_PROXY=1

# Contato exigido pelo OpenStreetMap para usar os mapas
MAPA_USER_AGENT=Vagai/1.0 (contato@vagai.com.br)

# Mercado Pago (destaque pago por PIX). Sem o token, a opção de destaque não aparece.
MERCADOPAGO_ACCESS_TOKEN=
# E-mail enviado como "pagador" (o Mercado Pago exige um; não pode ser o da sua própria conta)
PIX_EMAIL_PAGADOR=
# Preço do destaque por semana (planos de 1, 2 e 4 semanas)
PRECO_DESTAQUE_SEMANA=10.00
